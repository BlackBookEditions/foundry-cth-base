{
  "id": "cth-base",
  "title": "Chroniques Oubliées Cthulhu Origines",
  "description": "Adaptation du module Chroniques Oubliées Contemporain 2e édition aux règles de Chroniques Oubliées Cthulhu Origines",
  "url": "#{URL}#",
  "version": "#{VERSION}#",
  "compatibility": { "minimum": "14", "maximum": "14", "verified": "14" },
  "relationships": {
    "systems": [
      { "id": "co2", "type": "system", "compatibility": { "verified": "2.3.0" } }
    ],
    "requires": [
      { "id": "coc2-base", "type": "module" }
    ],
    "optional": []
  },
  "packs": [
    {
      "label": "CTH Témoin",
      "type": "Item",
      "name": "cth-temoin",
      "path": "packs/cth-temoin",
      "system": "co2",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "label": "CTH Archiviste",
      "type": "Item",
      "name": "cth-archiviste",
      "path": "packs/cth-archiviste",
      "system": "co2",
      "ownership": { "PLAYER": "NONE", "ASSISTANT": "OWNER" }
    }
  ],
  "authors": [ { "name": "kristov" } ],
  "esmodules": ["cth-base.mjs"],
  "styles": [{ "src": "cth-base.css", "layer": "cth-base" }],
  "languages": [ { "lang": "fr", "name": "French", "path": "lang/fr.json" } ],
  "socket": false,
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#"
}
